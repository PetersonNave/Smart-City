{
  "expo": {
    "name": "ResolveAi",
    "slug": "smart-city",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.resolveai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.resolveai.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "O ResolveAí usa suas fotos para anexar imagens às demandas registradas."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ResolveAí usa sua localização para preencher o endereço da demanda automaticamente."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O ResolveAí usa a câmera para fotografar o problema que você está registrando.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#329D9C",
          "defaultChannel": "demandas"
        }
      ],
      "expo-router"
    ],
    "scheme": "resolveai",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/fa4473b4-f537-4fd9-8368-c33582947e19",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa4473b4-f537-4fd9-8368-c33582947e19"
      }
    },
    "owner": "peterson_meloo"
  }
}
