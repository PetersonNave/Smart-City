{
  "name": "smart-city",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "axios": "^1.20.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "lucide-react-native": "^1.47.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "axios-mock-adapter": "^2.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "test-renderer": "~1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "build:apk": "npx --yes eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx --yes eas-cli@latest build --platform ios --profile preview",
    "update:preview": "npx --yes eas-cli@latest update --channel preview",
    "update:production": "npx --yes eas-cli@latest update --channel production"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|@sentry/react-native|native-base|lucide-react-native|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "testTimeout": 15000,
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/src/test-utils/styleMock.js"
    }
  }
}
